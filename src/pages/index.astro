---
import BaseLayout from '../layouts/BaseLayout.astro';
import SideMenu from '../components/SideMenu.astro';
import RightSidebar from '../components/RightSidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
const nav = [
  ['STRONA GŁÓWNA','#top'],['PTAKI ŁOWNE','#ptaki'],['DRAPIEŻNIKI','#drapieznik'],
  ['SOKOLNICTWO','#sokolnictwo'],['JASTRZĘBIARSTWO','#jastrzebiarstwo'],['PSY MYŚLIWSKIE','#psy'],
  ['HISTORIA','#historia'],['RESTYTUCJA','#restytucja'],['GALERIA','#galeria'],['LINKI','#linki']
];
---
<BaseLayout>
<main class="page" id="top">
<header class="hero">
  <div class="hero-art" aria-hidden="true">
    <div class="canopy"></div><div class="lake"></div><div class="castle">♜</div>
    <img class="hero-bird" src="/sokolnictwo-nowa-strona/images/birds/falcon-peregrine-main.svg" alt="Sokół wędrowny — rycina przyrodnicza" />
    <div class="hero-label">Człowiek i ptak<br/>— wspólna droga od wieków...</div>
  </div>
  <div class="hero-title"><p class="eyebrow">TRADYCJA • WIEDZA • NATURA • PASJA</p><h1>Sokolnictwo<br/><span>Jastrzębiarstwo</span></h1><div class="rule">❦</div><p>O sztuce polowania z ptakami drapieżnymi</p></div>
</header>
<div class="columns">
<SideMenu />
<section class="main-content">
  <article class="panel intro" id="sokolnictwo">
    <h2>Sokolnictwo i Jastrzębiarstwo</h2><div class="ornament">— ❧ —</div>
    <div class="intro-grid"><div class="flight-scene"><svg viewBox="0 0 420 220" aria-label="Rysunek sokoła nad leśnym jeziorem"><path d="M0 160 Q80 132 140 156 T280 149 T420 160 V220 H0Z" class="hills"/><path d="M0 190 Q100 175 190 194 T420 187" class="water"/><g class="trees"><path d="M20 176V70m-18 40 18-29 18 29M53 170V45m-23 42 23-34 23 34M365 171V56m-20 42 20-31 21 31M393 176V84m-16 28 16-23 16 23"/></g><path d="M55 92 Q102 43 155 75 L190 99 232 56 251 22 267 63 305 76 348 67 325 90 289 99 272 126 292 146 328 166 347 180 319 188 281 170 247 151 216 149 180 166 144 184 111 194 89 176 103 148Z" class="bird"/><path d="M254 29 L276 7 270 59 M190 99 L154 62 164 116" class="bird-line"/></svg></div><p>Strona poświęcona tradycji, historii i współczesności sokolnictwa w Polsce i na świecie. Znajdziesz tu informacje o ptakach łownych i drapieżnikach, metodach szkolenia, historii tej niezwykłej sztuki oraz o ochronie i restytucji ptaków drapieżnych.</p></div>
  </article>
  <article class="panel news" id="historia"><h2>❧ Aktualności</h2>
    <div class="news-row"><div class="thumb">♞ ❧</div><div><time>09.10.2026</time><h3>Trwają prace nad przywróceniem dawnej strony</h3><p>Celem projektu jest odtworzenie i zachowanie jak największej części dziedzictwa historycznego polskich mediów internetowych.</p></div></div>
    <div class="news-row"><div class="thumb">➶</div><div><time>02.10.2026</time><h3>Odnaleziono w europejskim archiwum</h3><p>W archiwach odnaleziono pierwszą wersję strony o sokolnictwie w Polsce, powstałą w 2004 roku. Trwają prace nad jej rekonstrukcją.</p></div></div>
    <a class="all-news" href="#historia">Zobacz wszystkie aktualności →</a>
  </article>
  <div class="topics">
    <article class="panel topic" id="jastrzebiarstwo"><h3>Jastrzębiarstwo</h3><p>Tradycja łowów z jastrzębiami i ich wyjątkowa więź z człowiekiem.</p></article>
    <article class="panel topic" id="ptaki"><h3>Ptaki łowne</h3><p>Gatunki, biologia, zwyczaje i odpowiedzialna opieka.</p></article>
    <article class="panel topic" id="drapieznik"><h3>Drapieżniki</h3><p>Świat ptaków drapieżnych, ich środowisko i ochrona.</p></article>
  </div>
  <article class="panel lower" id="restytucja"><h3>Ochrona i restytucja</h3><p>Materiały o ochronie ptaków drapieżnych i zachowaniu ich populacji.</p></article>
  <article class="panel lower" id="psy"><h3>Psy myśliwskie</h3><p>Dział poświęcony psom towarzyszącym tradycjom łowieckim.</p></article>
  <article class="panel lower" id="galeria"><h3>Galeria</h3><p>Fotografie ptaków łowczych, sprzętu sokolniczego i scen terenowych.</p></article>
  <article class="panel lower" id="linki"><h3>Literatura i ciekawe linki</h3><p>Sprawdzone źródła, organizacje sokolnicze i publikacje będą dodawane etapami.</p></article>
</section>
<RightSidebar />
</div>
<SiteFooter />
</main>
</BaseLayout>
<style>
:global(body){background:#aab68a}.page{max-width:1240px;margin:auto;padding:18px;color:#17281a;font-family:Georgia,serif;background:#d8dfb3;background-image:radial-gradient(#4654381c .7px,transparent .7px);background-size:5px 5px;box-shadow:0 0 35px #1d2d1c44}.hero{display:grid;grid-template-columns:55% 45%;min-height:315px;position:relative;overflow:hidden;border:1px solid #536344;outline:2px solid #c4c99b;outline-offset:-7px;background:#344831;color:#f0edca}.hero-art{position:relative;min-height:315px;overflow:hidden;background:linear-gradient(#c5d09e 0%,#8f9f70 46%,#31472f 100%)}.hero-art:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(12deg,transparent 0 7px,#243b25 8px,transparent 9px 13px);opacity:.13}.canopy{position:absolute;inset:0 0 45%;background:radial-gradient(ellipse at 10% 0,#263d22 0 13%,transparent 14%),radial-gradient(ellipse at 34% 0,#3b512c 0 14%,transparent 15%),radial-gradient(ellipse at 70% 5%,#5a693c 0 12%,transparent 13%);opacity:.8}.lake{position:absolute;bottom:20%;left:0;right:0;height:24%;background:repeating-linear-gradient(0deg,#d5d9a3 0 2px,#6b8056 3px 5px);opacity:.8}.castle{position:absolute;right:5%;bottom:35%;font-size:52px;color:#4b5b3b;text-shadow:1px 1px #e1dcad}.hero-bird{position:absolute;z-index:2;left:5%;bottom:-3%;width:62%;height:94%;fill:#1b2d1d;stroke:#d0c99b;stroke-width:1.4;stroke-linejoin:round;filter:drop-shadow(2px 3px 0 #263622)}.hero-label{position:absolute;z-index:3;right:3%;top:24%;font:italic 19px Georgia,serif;text-align:center;color:#263622}.hero-title{align-self:center;text-align:center;padding:35px 25px}.eyebrow{font-size:11px;letter-spacing:.18em;margin:0 0 19px;color:#d8d2a7}.hero-title h1{font-size:clamp(34px,3.5vw,56px);font-weight:500;line-height:1.04;margin:0;text-shadow:1px 2px #101e13}.hero-title h1 span{font-size:.9em}.rule{display:flex;align-items:center;gap:12px;max-width:300px;margin:12px auto;color:#d2c997}.rule:before,.rule:after{content:"";height:1px;background:#b8bc8a;flex:1}.hero-title>p:last-child{font-style:italic;color:#e0d9b5}.columns{display:grid;grid-template-columns:225px minmax(350px,1fr) 255px;gap:12px;margin-top:13px;align-items:start}.sidebar{background:#d5d7ad;border:2px ridge #7c845d;padding:13px 10px;box-shadow:inset 0 0 0 4px #e9e6bf}.sidebar h2{text-align:center;font-size:24px;margin:4px 0 13px}.sidebar h2 span{font-size:18px}.sidebar nav{display:grid;gap:5px}.nav-item{display:grid;grid-template-columns:17px 1fr 23px;align-items:center;gap:5px;min-height:37px;padding:6px 6px;background:#ece9c8;border:1px solid #898c65;outline:1px solid #b8b98d;outline-offset:-4px;text-decoration:none;color:#1d2c1c;font-size:11px;font-weight:bold}.nav-item b{color:#926b32}.nav-item i{text-align:center;color:#4d6140;font-size:17px}.nav-item:hover,.nav-item.active{background:#c4cea0}.sidebar-scene{text-align:center;margin-top:17px;padding:16px 4px 8px;border-top:1px solid #92966c;color:#596a45;font-size:27px}.sidebar-scene p{font-style:italic;font-size:13px;color:#303e28}.main-content{min-width:0;display:grid;gap:11px}.panel{background:#f0edc9;border:1px solid #8b9066;outline:1px solid #c0bf8d;outline-offset:-5px;box-shadow:inset 0 0 0 2px #e0dfb5;padding:17px;color:#1d2b1b}.intro h2{text-align:center;font-size:clamp(22px,2.1vw,34px);margin:0;font-weight:600}.ornament{text-align:center;color:#65774b;padding:5px;border-bottom:1px solid #c1c39a;margin-bottom:12px}.intro-grid{display:grid;grid-template-columns: minmax(0, 1.7fr) minmax(130px,1fr);gap:15px;align-items:center}.intro-grid p{font-size:13px;line-height:1.55;margin:0}.flight-scene{background:linear-gradient(#d6dfb1,#b4c291);border:1px solid #a0a77b}.flight-scene svg{width:100%;display:block;fill:#283d28;stroke:#4d5d39;stroke-width:1.3}.flight-scene .hills{fill:#657b4d}.flight-scene .water{fill:none;stroke:#dfe2b1;stroke-width:3}.flight-scene .trees{fill:none;stroke:#344b2d;stroke-width:5}.flight-scene .bird{fill:#263824;stroke:#c5c796;stroke-width:1.2}.flight-scene .bird-line{fill:none;stroke:#b7bd8b}.news h2{font-size:24px;margin:0 0 10px;border-bottom:1px solid #c2c39a;padding-bottom:8px}.news-row{display:grid;grid-template-columns:125px 1fr;gap:12px;padding:8px 0;border-bottom:1px solid #cecca5}.thumb{min-height:76px;display:grid;place-items:center;background:linear-gradient(145deg,#7f9660,#d6dcb0);border:1px solid #a6a981;color:#263d28;font-size:35px}.news time{font-size:11px;color:#8a512e}.news h3{font-size:15px;margin:3px 0 4px}.news p,.topic p,.lower p{font-size:12px;line-height:1.5;margin:0}.all-news{display:block;text-align:right;font-size:11px;color:#34482c;text-decoration:none;margin-top:8px}.topics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.topic h3,.lower h3{font-size:20px;margin:0 0 7px}.topic{padding:15px}.lower{padding:14px}.rightbar{display:grid;gap:10px}.rightbar .panel{padding:13px}.rightbar h2{font-size:16px;margin:0 0 10px;border-bottom:1px solid #c1c29a;padding-bottom:8px}.raptor-head{height:130px;display:grid;place-items:center;background:linear-gradient(130deg,#61744b,#c7d19a);overflow:hidden}.raptor-head svg{height:100%;width:100%;fill:#1b2a1b;stroke:#d4d0a3;stroke-width:1.4}.raptor-head .feather{fill:#394d30}.raptor-head .eye-ring{fill:#d0b45a;stroke:#252d1d}.raptor-head .eye{fill:#11190f}.raptor-head .beak{fill:#b9a15b}.caption{text-align:center;font-size:12px;margin:5px}.dots{text-align:center;color:#405637;font-size:12px;letter-spacing:3px}.gallery>a{display:block;text-align:right;text-decoration:none;color:#35482e;font-size:11px;margin-top:7px}.link-panel a{display:flex;justify-content:space-between;gap:5px;padding:5px 1px;border-bottom:1px solid #d1cea6;text-decoration:none;color:#273725;font-size:11px}.link-panel a span{color:#697c4b}.quote p{font-size:17px;font-style:italic;line-height:1.5}.quote>span{display:block;text-align:center;font-size:30px;color:#697b4d}.footer{display:flex;align-items:center;gap:20px;flex-wrap:wrap;background:#203626;color:#e1dfb7;margin:14px -18px -18px;padding:15px 25px;font-size:12px}.footer>span{font-size:22px}.footer small{margin-left:auto;font-size:10px}@media(max-width:1050px){.columns{grid-template-columns:195px minmax(0,1fr)}.rightbar{grid-column:2;grid-template-columns:repeat(3,minmax(0,1fr))}.hero{grid-template-columns:48% 52%}.hero-label{font-size:15px}.topics{grid-template-columns:1fr}}@media(max-width:650px){.page{padding:7px}.hero{grid-template-columns:1fr}.hero-art{min-height:190px;order:2}.hero-title{order:1;padding:25px 12px}.hero-title h1{font-size:38px}.hero-label{font-size:14px;top:10%;right:4%}.columns{display:flex;flex-direction:column}.sidebar,.main-content,.rightbar{width:100%;box-sizing:border-box}.sidebar nav{grid-template-columns:repeat(2,minmax(0,1fr))}.sidebar-scene{display:none}.intro-grid{grid-template-columns:1fr}.intro-grid p{font-size:13px}.rightbar{display:grid;grid-template-columns:1fr}.news-row{grid-template-columns:88px 1fr}.thumb{min-height:80px}.footer{margin:10px -7px -7px;padding:15px;gap:10px}.footer small{margin-left:0}.topics{grid-template-columns:1fr}}
</style>