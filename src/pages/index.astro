---
import BaseLayout from '../layouts/BaseLayout.astro';
import SideMenu from '../components/SideMenu.astro';
import RightSidebar from '../components/RightSidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
<main class="page" id="top">
<header class="hero">
  <div class="hero-art"><img class="hero-landscape" src={`${base}images/scenes/hero-landscape.svg`} alt="Rycina leśnego jeziora, sokołów i tradycyjnego krajobrazu sokolniczego" /></div>
  <div class="hero-title"><p class="eyebrow">TRADYCJA • WIEDZA • NATURA • PASJA</p><h1>Sokolnictwo<br/><span>Jastrzębiarstwo</span></h1><div class="rule">❦</div><p>O sztuce polowania z ptakami drapieżnymi</p></div>
</header>
<div class="columns">
<SideMenu />
<section class="main-content">
  <article class="panel intro" id="sokolnictwo">
    <h2>Sokolnictwo i Jastrzębiarstwo</h2><div class="ornament">— ❧ —</div>
    <div class="intro-grid"><div class="flight-scene"><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Sokół w locie nad jeziorem i lasem" loading="lazy" /></div><p>Strona poświęcona tradycji, historii i współczesności sokolnictwa w Polsce i na świecie. Znajdziesz tu informacje o ptakach łownych i drapieżnikach, metodach szkolenia, historii tej niezwykłej sztuki oraz o ochronie i restytucji ptaków drapieżnych.</p></div>
  </article>
  <article class="panel news" id="historia"><h2>❧ Aktualności</h2>
    <div class="news-row"><div class="thumb"><img src={`${base}images/scenes/news-hawking.svg`} alt="Rycina sokolnika z ptakiem" loading="lazy" /></div><div><time>09.10.2026</time><h3>Trwają prace nad przywróceniem dawnej strony</h3><p>Celem projektu jest odtworzenie i zachowanie jak największej części dziedzictwa historycznego polskich mediów internetowych.</p></div></div>
    <div class="news-row"><div class="thumb"><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Rycina sokoła w locie" loading="lazy" /></div><div><time>02.10.2026</time><h3>Rekonstrukcja dawnej oprawy graficznej</h3><p>Pracujemy nad odtworzeniem charakterystycznego wyglądu strony z 2006 roku: układu, kolorystyki, ozdobnych ramek i ilustracji przyrodniczych.</p></div></div>
    <a class="all-news" href="#historia">Zobacz wszystkie aktualności →</a>
  </article>
  <div class="topics">
    <article class="panel topic" id="jastrzebiarstwo"><div class="topic-art"><img src={`${base}images/birds/goshawk-perched.svg`} alt="Rycina jastrzębia na gałęzi" loading="lazy" /></div><h3>Jastrzębiarstwo</h3><p>Tradycja łowów z jastrzębiami i ich wyjątkowa więź z człowiekiem.</p></article>
    <article class="panel topic" id="ptaki"><div class="topic-art"><img src={`${base}images/birds/falcon-head-gallery.svg`} alt="Rycina głowy sokoła wędrownego" loading="lazy" /></div><h3>Ptaki łowne</h3><p>Gatunki, biologia, zwyczaje i odpowiedzialna opieka.</p></article>
    <article class="panel topic" id="drapieznik"><div class="topic-art"><img src={`${base}images/birds/falcon-peregrine-main.svg`} alt="Rycina sokoła wędrownego" loading="lazy" /></div><h3>Drapieżniki</h3><p>Świat ptaków drapieżnych, ich środowisko i ochrona.</p></article>
  </div>
  <article class="panel lower illustrated-section" id="restytucja"><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Sokół nad naturalnym środowiskiem" loading="lazy" /><div><h3>Ochrona i restytucja</h3><p>Materiały o ochronie ptaków drapieżnych, odtwarzaniu populacji i zachowaniu ich naturalnych siedlisk.</p></div></article>
  <article class="panel lower illustrated-section" id="psy"><img src={`${base}images/scenes/hunting-dog-engraving.svg`} alt="Rycina psa myśliwskiego w profilu" loading="lazy" /><div><h3>Psy myśliwskie</h3><p>Dział poświęcony rasom, pracy w terenie i tradycjom psów towarzyszących łowiectwu.</p></div></article>
  <article class="panel lower gallery-section" id="galeria"><h3>Galeria</h3><p>Ptaki łowne i sceny sokolnicze — ilustracje w osobnych plikach, gotowe do podmiany na fotografie.</p><div class="gallery-grid"><figure><img src={`${base}images/birds/falcon-peregrine-main.svg`} alt="Sokół wędrowny" loading="lazy" /><figcaption>Sokół wędrowny</figcaption></figure><figure><img src={`${base}images/birds/goshawk-perched.svg`} alt="Jastrząb na gałęzi" loading="lazy" /><figcaption>Jastrząb</figcaption></figure><figure><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Ptak drapieżny nad jeziorem" loading="lazy" /><figcaption>Ptak w locie</figcaption></figure></div></article>
  <article class="panel lower" id="literatura"><h3>Literatura i ciekawe linki</h3><p>Sprawdzone źródła, organizacje sokolnicze i publikacje będą dodawane etapami.</p></article>
</section>
<RightSidebar />
</div>
<SiteFooter />
</main>
</BaseLayout>
<style is:global>
:global(body){background:#aab68a}.page{max-width:1240px;margin:auto;padding:18px;color:#17281a;font-family:Georgia,serif;background:#d8dfb3;background-image:radial-gradient(#4654381c .7px,transparent .7px);background-size:5px 5px;box-shadow:0 0 35px #1d2d1c44}.hero{display:grid;grid-template-columns:55% 45%;min-height:315px;position:relative;overflow:hidden;border:1px solid #536344;outline:2px solid #c4c99b;outline-offset:-7px;background:#344831;color:#f0edca}.hero-art{position:relative;min-height:315px;overflow:hidden;background:#9eaf78}.hero-landscape{display:block;width:100%;height:100%;min-height:315px;object-fit:cover}.hero-art{display:flex;align-items:stretch}.hero-art .hero-landscape{min-height:100%;object-fit:cover}.hero-art:before{content:"";position:absolute;inset:0;pointer-events:none;border:1px solid #bfc69a;z-index:2}.hero-title{align-self:center;text-align:center;padding:35px 25px}.eyebrow{font-size:11px;letter-spacing:.18em;margin:0 0 19px;color:#d8d2a7}.hero-title h1{font-size:clamp(34px,3.5vw,56px);font-weight:500;line-height:1.04;margin:0;text-shadow:1px 2px #101e13}.hero-title h1 span{font-size:.9em}.rule{display:flex;align-items:center;gap:12px;max-width:300px;margin:12px auto;color:#d2c997}.rule:before,.rule:after{content:"";height:1px;background:#b8bc8a;flex:1}.hero-title>p:last-child{font-style:italic;color:#e0d9b5}.columns{display:grid;grid-template-columns:225px minmax(350px,1fr) 255px;gap:12px;margin-top:13px;align-items:start}.nav-item:focus-visible,.all-news:focus-visible,.gallery>a:focus-visible,.link-panel a:focus-visible{outline:3px solid #8a6732;outline-offset:2px}.nav-item:hover,.link-panel a:hover{background:#e8e5bd;color:#17281a}.all-news:hover,.gallery>a:hover{text-decoration:underline}.panel,.sidebar{min-width:0}.news-row>div:last-child{min-width:0}.sidebar{background:#d5d7ad;border:2px ridge #7c845d;padding:13px 10px;box-shadow:inset 0 0 0 4px #e9e6bf}.sidebar h2{text-align:center;font-size:24px;margin:4px 0 13px}.sidebar h2 span{font-size:18px}.sidebar nav{display:grid;gap:5px}.nav-item{display:grid;grid-template-columns:17px 1fr 23px;align-items:center;gap:5px;min-height:37px;padding:6px 6px;background:#ece9c8;border:1px solid #898c65;outline:1px solid #b8b98d;outline-offset:-4px;text-decoration:none;color:#1d2c1c;font-size:11px;font-weight:bold}.nav-item b{color:#926b32}.nav-item i{text-align:center;color:#4d6140;font-size:17px}.nav-item:hover,.nav-item.active{background:#c4cea0}.sidebar-scene{min-height:120px;background-image:url("./images/scenes/falconer-vintage.svg`});background-position:center;background-size:cover;display:flex;flex-direction:column;justify-content:flex-end;color:#e9e4bb;text-shadow:1px 1px 2px #172719}.sidebar-scene p{background:#e5e1b6d9;padding:5px 2px;text-shadow:none;margin:0}.sidebar-scene{text-align:center;margin-top:17px;padding:16px 4px 8px;border-top:1px solid #92966c;font-size:27px}.sidebar-scene p{font-style:italic;font-size:13px;color:#303e28}.main-content{min-width:0;display:grid;gap:11px}.panel{position:relative;background:#f0edc9;border:1px solid #8b9066;outline:1px solid #c0bf8d;outline-offset:-5px;box-shadow:inset 0 0 0 2px #e0dfb5;padding:17px;color:#1d2b1b}.panel:before{content:"";position:absolute;inset:6px;border:1px solid #d0cea4;pointer-events:none}.panel>*{position:relative}.illustrated-section{display:grid;grid-template-columns:145px minmax(0,1fr);gap:16px;align-items:center}.illustrated-section>img{display:block;width:100%;height:100px;object-fit:cover;background:#dce1b8;border:1px solid #a6ad80}.illustrated-section h3{border-bottom:1px solid #b5bc8f;padding-bottom:6px}.topic-art{height:100px;overflow:hidden;background:linear-gradient(145deg,#dfe4bf,#b8c597);border:1px solid #a6ad80;box-shadow:inset 0 0 0 3px #d4d9ae;margin-bottom:10px;display:flex;align-items:center;justify-content:center}.topic-art img{display:block;width:100%;height:100%;object-fit:contain;object-position:center 25%}.topic h3{border-bottom:1px solid #b5bc8f;padding-bottom:5px}.intro h2{text-align:center;font-size:clamp(22px,2.1vw,34px);margin:0;font-weight:600}.ornament{text-align:center;color:#65774b;padding:5px;border-bottom:1px solid #c1c39a;margin-bottom:12px}.intro-grid{display:grid;grid-template-columns: minmax(0, 1.7fr) minmax(130px,1fr);gap:15px;align-items:center}.intro-grid p{font-size:13px;line-height:1.55;margin:0}.flight-scene{background:linear-gradient(#d6dfb1,#b4c291);border:1px solid #a0a77b;box-shadow:inset 0 0 0 4px #e4e4bd;padding:4px}.flight-scene img{width:100%;height:auto;display:block}.news h2{font-size:24px;margin:0 0 10px;border-bottom:1px solid #c2c39a;padding-bottom:8px}.news-row{display:grid;grid-template-columns:125px 1fr;gap:12px;padding:8px 0;border-bottom:1px solid #cecca5}.thumb{min-height:76px;display:grid;place-items:center;background:linear-gradient(145deg,#dfe4bf,#b8c597);border:1px solid #a6a981;box-shadow:inset 0 0 0 3px #d4d9ae;overflow:hidden}.thumb img{display:block;width:100%;height:100%;min-height:76px;object-fit:cover}.news time{font-size:11px;color:#8a512e}.news h3{font-size:15px;margin:3px 0 4px}.news p,.topic p,.lower p{font-size:12px;line-height:1.5;margin:0}.all-news{display:block;text-align:right;font-size:11px;color:#34482c;text-decoration:none;margin-top:8px}.topics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.topic h3,.lower h3{font-size:20px;margin:0 0 7px}.topic{padding:15px}.lower{padding:14px}.gallery-section>p{font-size:12px;line-height:1.5;margin:0 0 10px}.gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.gallery-grid figure{margin:0;min-width:0;background:#e0e3bd;border:1px solid #a6ad80;padding:4px;box-shadow:inset 0 0 0 2px #f0edca}.gallery-grid img{display:block;width:100%;height:105px;object-fit:contain;background:linear-gradient(#d9e0b7,#b4c291)}.gallery-grid figcaption{text-align:center;font-size:11px;padding:5px 0 2px}.rightbar{display:grid;gap:10px}.rightbar .panel{padding:13px}.rightbar h2{font-size:16px;margin:0 0 10px;border-bottom:1px solid #c1c29a;padding-bottom:8px}.raptor-head{height:130px;display:grid;place-items:center;background:linear-gradient(130deg,#61744b,#c7d19a);border:1px solid #a6ad80;box-shadow:inset 0 0 0 4px #dfe3b8;overflow:hidden}.raptor-head img{height:100%;width:100%;object-fit:cover;display:block}.caption{text-align:center;font-size:12px;margin:5px}.dots{text-align:center;color:#405637;font-size:12px;letter-spacing:3px}.gallery>a{display:block;text-align:right;text-decoration:none;color:#35482e;font-size:11px;margin-top:7px}.link-panel a{display:flex;justify-content:space-between;gap:5px;padding:5px 1px;border-bottom:1px solid #d1cea6;text-decoration:none;color:#273725;font-size:11px}.link-panel a span{color:#697c4b}.quote p{font-size:17px;font-style:italic;line-height:1.5}.quote>span{display:block;text-align:center;font-size:30px;color:#697b4d}.footer{display:flex;align-items:center;gap:20px;flex-wrap:wrap;background:#203626;color:#e1dfb7;margin:14px -18px -18px;padding:15px 25px;font-size:12px}.footer>span{font-size:22px}.footer small{margin-left:auto;font-size:10px}@media(max-width:1050px){.page{padding:12px}.columns{grid-template-columns:195px minmax(0,1fr)}.rightbar{grid-column:2;grid-template-columns:repeat(3,minmax(0,1fr))}.hero{grid-template-columns:48% 52%}.topics{grid-template-columns:1fr}}@media(max-width:650px){.gallery-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}.gallery-grid img{height:78px}.gallery-grid figcaption{font-size:10px}.illustrated-section{grid-template-columns:90px minmax(0,1fr);gap:10px}.illustrated-section>img{height:90px}.page{padding:7px}.hero{grid-template-columns:1fr}.hero-art .hero-landscape{width:100%;height:190px;min-height:190px;object-fit:cover}.hero-art{min-height:190px;order:2}.hero-title{order:1;padding:25px 12px}.hero-title h1{font-size:38px}.columns{display:flex;flex-direction:column}.sidebar,.main-content,.rightbar{width:100%;box-sizing:border-box}.sidebar nav{grid-template-columns:repeat(2,minmax(0,1fr))}.nav-item{font-size:10px;grid-template-columns:13px minmax(0,1fr) 16px;padding:5px 4px}.nav-item span{overflow-wrap:anywhere}.sidebar-scene{display:none}.intro-grid{grid-template-columns:1fr}.intro-grid p{font-size:13px}.rightbar{display:grid;grid-template-columns:1fr}.news-row{grid-template-columns:88px 1fr}.thumb{min-height:80px}.footer{margin:10px -7px -7px;padding:15px;gap:10px}.footer small{margin-left:0}.topics{grid-template-columns:1fr}}
</style>