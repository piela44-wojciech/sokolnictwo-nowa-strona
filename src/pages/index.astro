---
import BaseLayout from '../layouts/BaseLayout.astro';
import SideMenu from '../components/SideMenu.astro';
import RightSidebar from '../components/RightSidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
<main class="page" id="top">
<header class="hero">
  <div class="hero-art"><img class="hero-landscape" src={`${base}images/scenes/hero-landscape.svg`} alt="Rycina leśnego jeziora, sokołów i tradycyjnego krajobrazu sokolniczego" /></div>
  <div class="hero-title"><p class="eyebrow">TRADYCJA • WIEDZA • NATURA • PASJA</p><h1>Sokolnictwo<br/><span>Jastrzębiarstwo</span></h1><div class="rule">❦</div><p>O sztuce polowania z ptakami drapieżnymi</p></div>
</header>
<div class="columns">
<SideMenu />
<section class="main-content">
  <article class="panel intro" id="sokolnictwo">
    <h2>Sokolnictwo i Jastrzębiarstwo</h2><div class="ornament">— ❧ —</div>
    <div class="intro-grid"><div class="flight-scene"><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Sokół w locie nad jeziorem i lasem" loading="lazy" /></div><p>Strona poświęcona tradycji, historii i współczesności sokolnictwa w Polsce i na świecie. Znajdziesz tu informacje o ptakach łownych i drapieżnikach, metodach szkolenia, historii tej niezwykłej sztuki oraz o ochronie i restytucji ptaków drapieżnych.</p></div>
  </article>
  <article class="panel news" id="historia"><h2>❧ Aktualności</h2>
    <div class="news-row"><div class="thumb"><img src={`${base}images/scenes/news-hawking.svg`} alt="Rycina sokolnika z ptakiem" loading="lazy" /></div><div><time>09.10.2026</time><h3>Trwają prace nad przywróceniem dawnej strony</h3><p>Celem projektu jest odtworzenie i zachowanie jak największej części dziedzictwa historycznego polskich mediów internetowych.</p></div></div>
    <div class="news-row"><div class="thumb"><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Rycina sokoła w locie" loading="lazy" /></div><div><time>02.10.2026</time><h3>Rekonstrukcja dawnej oprawy graficznej</h3><p>Pracujemy nad odtworzeniem charakterystycznego wyglądu strony z 2006 roku: układu, kolorystyki, ozdobnych ramek i ilustracji przyrodniczych.</p></div></div>
    <a class="all-news" href="#historia">Zobacz wszystkie aktualności →</a>
  </article>
  <div class="topics">
    <article class="panel topic" id="jastrzebiarstwo"><div class="topic-art"><img src={`${base}images/birds/goshawk-perched.svg`} alt="Rycina jastrzębia na gałęzi" loading="lazy" /></div><h3>Jastrzębiarstwo</h3><p>Tradycja łowów z jastrzębiami i ich wyjątkowa więź z człowiekiem.</p></article>
    <article class="panel topic" id="ptaki"><div class="topic-art"><img src={`${base}images/birds/falcon-head-gallery.svg`} alt="Rycina głowy sokoła wędrownego" loading="lazy" /></div><h3>Ptaki łowne</h3><p>Gatunki, biologia, zwyczaje i odpowiedzialna opieka.</p></article>
    <article class="panel topic" id="drapieznik"><div class="topic-art"><img src={`${base}images/birds/falcon-peregrine-main.svg`} alt="Rycina sokoła wędrownego" loading="lazy" /></div><h3>Drapieżniki</h3><p>Świat ptaków drapieżnych, ich środowisko i ochrona.</p></article>
  </div>
  <article class="panel lower illustrated-section" id="restytucja"><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Sokół nad naturalnym środowiskiem" loading="lazy" /><div><h3>Ochrona i restytucja</h3><p>Materiały o ochronie ptaków drapieżnych, odtwarzaniu populacji i zachowaniu ich naturalnych siedlisk.</p></div></article>
  <article class="panel lower illustrated-section" id="psy"><img src={`${base}images/scenes/hunting-dog-engraving.svg`} alt="Rycina psa myśliwskiego w profilu" loading="lazy" /><div><h3>Psy myśliwskie</h3><p>Dział poświęcony rasom, pracy w terenie i tradycjom psów towarzyszących łowiectwu.</p></div></article>
  <article class="panel lower gallery-section" id="galeria"><h3>Galeria</h3><p>Ptaki łowne i sceny sokolnicze — ilustracje w osobnych plikach, gotowe do podmiany na fotografie.</p><div class="gallery-grid"><figure><img src={`${base}images/birds/falcon-peregrine-main.svg`} alt="Sokół wędrowny" loading="lazy" /><figcaption>Sokół wędrowny</figcaption></figure><figure><img src={`${base}images/birds/goshawk-perched.svg`} alt="Jastrząb na gałęzi" loading="lazy" /><figcaption>Jastrząb</figcaption></figure><figure><img src={`${base}images/scenes/falcon-flight-lake.svg`} alt="Ptak drapieżny nad jeziorem" loading="lazy" /><figcaption>Ptak w locie</figcaption></figure></div></article>
  <article class="panel lower" id="literatura"><h3>Literatura i ciekawe linki</h3><p>Sprawdzone źródła, organizacje sokolnicze i publikacje będą dodawane etapami.</p></article>
</section>
<RightSidebar />
</div>
<SiteFooter />
</main>
</BaseLayout>
<style is:global>
:global(body){margin:0;background:#d4d5c8;color:#1b2818;font-family:Georgia,"Times New Roman",serif}
.page{max-width:1500px;margin:0 auto;padding:10px 12px 0;background:#e5e7bd;background-image:radial-gradient(#52613a22 .8px,transparent .8px);background-size:5px 5px;box-shadow:0 0 30px #1d2d1c33}
.hero{position:relative;display:flex;align-items:flex-end;justify-content:center;min-height:405px;overflow:hidden;border:2px solid #45572e;outline:2px solid #b7be81;outline-offset:-8px;background:#cbd6a0;color:#162516}
.hero-art{position:absolute;inset:0;min-height:0;background:#b9c88d;overflow:hidden}
.hero-art .hero-landscape{display:block;width:100%;height:100%;min-height:0;object-fit:cover;object-position:center 48%}
.hero-art:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 48%,#e6e9bfaa 72%,#e4e8bfeF 100%);pointer-events:none}
.hero-title{box-sizing:border-box;z-index:1;position:relative;width:min(760px,70%);margin:0 0 8px;padding:10px 20px 7px;text-align:center;background:#e6e9bfbd;border:1px solid #7d8b4e;box-shadow:0 0 0 4px #d7dfab88;text-shadow:0 1px #f5f2d6}
.eyebrow{font-size:12px;letter-spacing:.15em;margin:0 0 4px;color:#334727;font-weight:bold}
.hero-title h1{font-size:clamp(36px,4.1vw,62px);font-weight:700;line-height:.96;margin:0;color:#152516;text-shadow:1px 2px #a9b57a}
.hero-title h1 span{font-size:.86em}
.rule{display:flex;align-items:center;gap:12px;max-width:440px;margin:5px auto;color:#3e522a;font-size:17px}
.rule:before,.rule:after{content:"";height:1px;background:#53683b;flex:1}
.hero-title>p:last-child{font-size:13px;font-weight:bold;letter-spacing:.08em;margin:3px 0 0;color:#273a22}
.columns{display:grid;grid-template-columns:minmax(245px,21%) minmax(0,1fr) minmax(260px,22%);gap:7px;margin-top:0;align-items:stretch}
.nav-item:focus-visible,.all-news:focus-visible,.gallery>a:focus-visible,.link-panel a:focus-visible{outline:3px solid #8a6732;outline-offset:2px}
.nav-item:hover,.link-panel a:hover{background:#f3f0ca;color:#17281a}
.all-news:hover,.gallery>a:hover{text-decoration:underline}
.panel,.sidebar{min-width:0}
.news-row>div:last-child{min-width:0}
.sidebar{background:#d9dfaa;border:3px ridge #697a3e;padding:10px 9px 8px;box-shadow:inset 0 0 0 4px #edf0c7;position:relative}
.sidebar h2{text-align:center;font-size:30px;margin:0 0 10px;padding:0 0 5px;border-bottom:3px double #738442}
.sidebar h2 span{font-size:23px}
.sidebar nav{display:grid;gap:4px}
.nav-item{display:grid;grid-template-columns:18px minmax(0,1fr) 29px;align-items:center;gap:5px;min-height:39px;padding:5px 6px;background:linear-gradient(#f2f0c9,#dfe4ad);border:2px ridge #899650;outline:1px solid #b5bd7a;outline-offset:-4px;text-decoration:none;color:#172516;font-size:clamp(10px,.9vw,14px);font-weight:bold;box-shadow:inset 0 0 0 2px #f7f4d3}
.nav-item b{color:#a06b21;font-size:17px}.nav-item i{text-align:center;color:#334c2b;font-size:22px;font-style:normal}
.nav-item:hover,.nav-item.active{background:linear-gradient(#f8f4d3,#cbd89b)}
.sidebar-scene{min-height:135px;background-image:url("/sokolnictwo-nowa-strona/images/scenes/falconer-vintage.svg");background-position:center;background-size:cover;display:flex;flex-direction:column;justify-content:flex-end;color:#e9e4bb;text-shadow:1px 1px 2px #172719;text-align:center;margin-top:10px;padding:16px 4px 8px;border-top:3px double #78864a}
.sidebar-scene p{background:#e5e8b9e8;padding:5px 2px;text-shadow:none;margin:0;font-style:italic;font-size:13px;color:#303e28}
.main-content{min-width:0;display:grid;gap:8px;align-content:start}\n/* Match the reference composition: intro and news remain in the center column. */\n.topics,.main-content>.lower{display:none}
.panel{position:relative;background:#eef0c6;border:2px ridge #8b9855;outline:1px solid #c0c98a;outline-offset:-5px;box-shadow:inset 0 0 0 3px #dce3aa;padding:15px;color:#1d2b1b}
.panel:before{content:"";position:absolute;inset:6px;border:1px solid #d0d7a0;pointer-events:none}.panel>*{position:relative}
.intro h2{text-align:center;font-size:clamp(24px,2.7vw,39px);margin:0;font-weight:700;line-height:1.1}
.ornament{text-align:center;color:#536b35;padding:4px;border-bottom:1px solid #b5bf83;margin-bottom:10px}
.intro-grid{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(155px,1fr);gap:14px;align-items:center}
.intro-grid p{font-size:clamp(12px,1vw,16px);line-height:1.42;margin:0}
.flight-scene{background:linear-gradient(#dce5b5,#aebf7e);border:1px solid #9ba967;box-shadow:inset 0 0 0 4px #e4e8bc;padding:4px}
.flight-scene img{width:100%;height:190px;object-fit:cover;display:block}
.news h2{font-size:clamp(22px,2vw,30px);margin:0 0 7px;border-bottom:1px solid #c2c99a;padding-bottom:6px}
.news-row{display:grid;grid-template-columns:minmax(105px,23%) minmax(0,1fr);gap:11px;padding:7px 0;border-bottom:1px solid #cecca5}
.thumb{min-height:78px;display:grid;place-items:center;background:linear-gradient(145deg,#dfe4bf,#b8c597);border:1px solid #a6a981;box-shadow:inset 0 0 0 3px #d4d9ae;overflow:hidden}
.thumb img{display:block;width:100%;height:100%;min-height:78px;object-fit:cover}
.news time{font-size:12px;color:#a04421}.news h3{font-size:clamp(13px,1.1vw,17px);margin:2px 0 4px}.news p,.topic p,.lower p{font-size:12px;line-height:1.45;margin:0}
.all-news{display:block;text-align:right;font-size:12px;color:#34482c;text-decoration:none;margin-top:6px}
.topics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.topic h3,.lower h3{font-size:20px;margin:0 0 7px}.topic{padding:11px}
.topic-art{height:110px;overflow:hidden;background:linear-gradient(145deg,#dfe4bf,#b8c597);border:1px solid #a6ad80;box-shadow:inset 0 0 0 3px #d4d9ae;margin-bottom:8px;display:flex;align-items:center;justify-content:center}
.topic-art img{display:block;width:100%;height:100%;object-fit:contain;object-position:center 25%}.topic h3{border-bottom:1px solid #b5bc8f;padding-bottom:5px}
.lower{padding:12px}.illustrated-section{display:grid;grid-template-columns:145px minmax(0,1fr);gap:13px;align-items:center}.illustrated-section>img{display:block;width:100%;height:100px;object-fit:cover;background:#dce1b8;border:1px solid #a6ad80}.illustrated-section h3{border-bottom:1px solid #b5bc8f;padding-bottom:6px}
.gallery-section>p{font-size:12px;line-height:1.5;margin:0 0 10px}
.gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.gallery-grid figure{margin:0;min-width:0;background:#e0e3bd;border:1px solid #a6ad80;padding:4px;box-shadow:inset 0 0 0 2px #f0edca}
.gallery-grid img{display:block;width:100%;height:105px;object-fit:contain;background:linear-gradient(#d9e0b7,#b4c291)}
.gallery-grid figcaption{text-align:center;font-size:11px;padding:5px 0 2px}
.rightbar{display:grid;gap:8px;align-content:start}.rightbar .panel{padding:12px}
.rightbar h2{font-size:clamp(14px,1.2vw,19px);margin:0 0 8px;border-bottom:1px solid #aeb77a;padding-bottom:7px}
.raptor-head{height:175px;display:grid;place-items:center;background:linear-gradient(130deg,#61744b,#c7d19a);border:1px solid #a6ad80;box-shadow:inset 0 0 0 4px #dfe3b8;overflow:hidden}
.raptor-head img{height:100%;width:100%;object-fit:cover;display:block}
.caption{text-align:center;font-size:12px;margin:5px}.dots{text-align:center;color:#405637;font-size:12px;letter-spacing:3px}
.gallery>a{display:block;text-align:right;text-decoration:none;color:#35482e;font-size:12px;margin-top:7px}
.link-panel a{display:flex;justify-content:space-between;gap:5px;padding:5px 1px;border-bottom:1px solid #d1cea6;text-decoration:none;color:#273725;font-size:clamp(11px,.9vw,14px)}
.link-panel a span{color:#697c4b}.quote p{font-size:clamp(15px,1.4vw,20px);font-style:italic;line-height:1.45}.quote>span{display:block;text-align:center;font-size:30px;color:#697b4d}
.footer{display:flex;align-items:center;gap:20px;flex-wrap:wrap;background:#203626;color:#e1dfb7;margin:8px -12px 0;padding:15px 25px;font-size:12px;border-top:3px ridge #7b8946}
.footer>span{font-size:22px}.footer small{margin-left:auto;font-size:10px}
@media(max-width:1050px){.page{padding:8px}.hero{min-height:330px}.columns{grid-template-columns:195px minmax(0,1fr)}.rightbar{grid-column:2;grid-template-columns:repeat(3,minmax(0,1fr))}.raptor-head{height:110px}.topics{grid-template-columns:1fr}.hero-title{width:min(720px,85%)}}
@media(max-width:650px){.page{padding:5px}.hero{min-height:300px}.hero-art .hero-landscape{object-position:center;}.hero-title{width:94%;padding:10px 7px}.hero-title h1{font-size:36px}.eyebrow{font-size:9px}.columns{display:flex;flex-direction:column}.sidebar,.main-content,.rightbar{width:100%;box-sizing:border-box}.sidebar nav{grid-template-columns:repeat(2,minmax(0,1fr))}.nav-item{font-size:10px;grid-template-columns:13px minmax(0,1fr) 16px;padding:5px 4px}.nav-item span{overflow-wrap:anywhere}.sidebar-scene{display:none}.intro-grid{grid-template-columns:1fr}.intro-grid p{font-size:13px}.flight-scene img{height:180px}.rightbar{display:grid;grid-template-columns:1fr}.news-row{grid-template-columns:88px 1fr}.thumb{min-height:80px}.topics{grid-template-columns:1fr}.gallery-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}.gallery-grid img{height:78px}.gallery-grid figcaption{font-size:10px}.illustrated-section{grid-template-columns:90px minmax(0,1fr);gap:10px}.illustrated-section>img{height:90px}.footer{margin:8px -5px 0;padding:15px;gap:10px}.footer small{margin-left:0}}
</style>