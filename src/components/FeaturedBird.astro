---
const base = import.meta.env.BASE_URL;
interface Props { src?: string; alt?: string; className?: string; }
const { src = `${base}images/birds/falcon-peregrine-main.svg`, alt = 'Sokół wędrowny — rycina przyrodnicza', className = '' } = Astro.props;
---
<img class={className} src={src} alt={alt} loading="eager" decoding="async" />